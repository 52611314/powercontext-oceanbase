# CiteSeek 配置示例：复制为 deploy/.env 后按需修改
CITESEK_SEEKDB_HOST=127.0.0.1
CITESEK_SEEKDB_PORT=2881
CITESEK_SEEKDB_USER=root
CITESEK_SEEKDB_PASSWORD=
CITESEK_SEEKDB_DB=citeseek

CITESEK_DATA_DIR=../data
CITESEK_MAX_UPLOAD_MB=100
CITESEK_CHUNK_SIZE=420
CITESEK_CHUNK_OVERLAP=80
CITESEK_EMBED_BATCH=16
CITESEK_INDEX_WORKERS=2
